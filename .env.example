# Скопируйте этот файл в .env (или задайте на хостинге как Environment Variables).
# Никогда не коммитьте настоящий .env в git.

# Токен от @BotFather (выглядит как 1234567890:AA...)
TELEGRAM_BOT_TOKEN=

# ID чата, куда будут приходить заявки. Может быть отрицательным для групп.
# Узнать можно через @userinfobot или вызвав getUpdates после первого сообщения боту.
TELEGRAM_CHAT_ID=
